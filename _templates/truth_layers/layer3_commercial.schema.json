{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Truth Layer 3 - Commercial Evidence",
  "type": "object",
  "required": ["layer", "buyer_id", "settled_payment_event_id", "amount_cents", "currency", "livemode", "fulfillment_artifact_sha256", "retention_signal"],
  "properties": {
    "layer": { "const": 3 },
    "buyer_id": { "type": "string", "minLength": 1 },
    "settled_payment_event_id": { "type": "string", "minLength": 1 },
    "amount_cents": { "type": "integer", "minimum": 1 },
    "currency": { "type": "string", "pattern": "^[a-z]{3}$" },
    "livemode": { "const": true },
    "fulfillment_artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "retention_signal": { "enum": ["NONE", "REPEAT_PURCHASE", "REFERRAL", "THIRTY_DAY_USAGE", null] },
    "promotion_power": { "const": "COMMERCIAL_OUTCOME" }
  },
  "additionalProperties": true
}
