{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Truth Layer 1 - Canonical System State",
  "type": "object",
  "required": ["layer", "system", "path", "observed_at", "inspector", "sha256", "status"],
  "properties": {
    "layer": { "const": 1 },
    "system": { "type": "string" },
    "path": { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "inspector": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["PRESENT", "PRESENT_BUT_BLOCKED", "MISSING", "CONTRADICTED", "STALE", "UNKNOWN"] },
    "promotion_power": { "const": "IMPLEMENTATION_ONLY" },
    "cannot_prove": { "const": ["market_demand", "revenue", "commercial_viability"] }
  },
  "additionalProperties": true
}
