{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Truth Layer 2 - Verified External Research",
  "type": "object",
  "required": ["layer", "source_url", "retrieved_at", "primary_source", "claim_text", "verification_status", "verifier", "verification_method"],
  "properties": {
    "layer": { "const": 2 },
    "source_url": { "type": "string", "format": "uri" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "primary_source": { "type": "boolean" },
    "claim_text": { "type": "string" },
    "verification_status": { "enum": ["UNVERIFIED", "PARTIALLY_VERIFIED", "VERIFIED"] },
    "verifier": { "type": "string" },
    "verification_method": { "type": "string" },
    "promotion_power": { "const": "COMMERCIAL_DECISION_SUPPORT_ONLY" },
    "cannot_prove": { "const": ["demand", "revenue"] }
  },
  "additionalProperties": true
}
