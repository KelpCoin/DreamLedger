      "inputs": [
        "job_spec",
        "input_ref"
      ],
      "outputs": [
        "artifact_ref",
        "usage",
        "proof_ref"
      ],
      "authorization": "buyer_required"
    },
    {
      "id": "gpu.transform",
      "state": "READY_TO_WIRE",
      "pricing": [
        "per_asset",
        "per_minute"
      ],
      "inputs": [
        "asset_ref",
        "operation"
      ],
      "outputs": [
        "artifact_ref",
        "usage",
        "proof_ref"
      ],
      "authorization": "buyer_required"
    },
    {
      "id": "gpu.render",
      "state": "READY_TO_WIRE",
      "pricing": [
        "per_job",
        "per_minute"
      ],
      "inputs": [
        "render_spec",
        "asset_refs"
      ],
      "outputs": [
        "artifact_ref",
        "usage",
        "proof_ref"
      ],
      "authorization": "buyer_required"
    }
  ],
  "rails": {
    "human": "Stripe",
    "machine": "A2A toll-road / existing DreamLedger agent bridge",
    "discovery": "https://dreamledger.org/agent-commerce.json",
    "payment_rule": "No autonomous external spend without buyer authorization."
  },
  "execution": {
    "preferred_local_runtime": "LM Studio / llmster",
    "cloud_fallback": "per existing DreamLedger production substrate",
    "metering": [
      "job_id",
      "start_time",
      "end_time",
      "model",
      "tokens_or_units",
      "artifact_ref"
    ],
    "reconciliation": "cloud-authoritative; local acceleration",
    "truth_states": [
      "DISCOVERABLE",
      "AUTHORIZED",
      "RUNNING",
      "DELIVERED",
      "PAYMENT_OBSERVED",
      "SETTLED",
      "VERIFIED"
    ]
  },
  "safety": {
    "no_hidden_cryptomining": true,
    "no_unauthorized_third_party_compute": true,
    "no_background_external_jobs_without_authorization": true,
    "no_revenue_claim_without_settled_payment_and_fulfillment": true
  },
  "next_best_money_action": "Wire one small paid inference capability to the existing toll/payment rail, then prove one independent buyer and one fulfilled job before expanding capacity."
