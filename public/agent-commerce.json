    "public_without_token": false,
    "settlement": "stripe_live_nzd",
    "economic_truth": "Bridge activity is not revenue. Revenue requires Stripe payment evidence plus fulfillment proof.",
    "toll_model": {
      "discovery": "public_free_enough_to_try",
      "bridge_rail": "token_gated_toll_road",
      "proof_attestation": "chargeable_validation",
      "human_checkout": "stripe_payment_link_or_buy_router",
      "platform_success_fee_bps_on_public_offers": 0
    },
    "protocol_alignment": {
      "authorization": "AP2-like human authorization before spend",
      "checkout": "ACP-like Payment Link / buy router handoff",
      "machine_settlement_reserved": ["x402", "mpp"]
    }
  },
  "fee_policy": {
    "platform_listing_fee_nzd": 0,
    "platform_success_fee_bps": 0,
    "payment_processor": "Stripe",
    "note": "Listed NZD price is what the buyer pays for the offer. Stripe processing fees are separate. Bridge/token access is a separate product surface."
  },
  "economic_event": {
    "order": ["authorized", "paid", "delivered", "proven", "ledgered"],
    "settlement_authority": "stripe_live_only",
    "rule": "A checkout start is not revenue. Ledgered revenue requires external Stripe payment evidence, product attribution, and fulfillment proof.",
    "client_reference": "Always use https://dreamledger.org/buy/{product_id} so Stripe client_reference_id binds the product_id."
  },
  "ledger": {
