{
  "schema": "dreamledger/agent-commerce/v3",
  "updated": "2026-09-27",
  "purpose": "Machine-readable commerce contract. DreamLedger is the validation layer: discover → authorize → pay (Stripe) → deliver → prove → ledger.",
  "storefront": "https://dreamledger.org/",
  "thesis": "In an agentic commerce boom, the scarce asset is not discovery — it is trusted settlement and post-payment proof. DreamLedger ledgers only what Stripe and fulfillment can support.",
  "fee_policy": {
    "platform_listing_fee_nzd": 0,
    "platform_success_fee_bps": 0,
    "payment_processor": "Stripe",
    "note": "Listed NZD price is what the buyer pays for the offer. Stripe processing fees are separate."
  },
  "economic_event": {
    "order": ["authorized", "paid", "delivered", "proven", "ledgered"],
    "settlement_authority": "stripe_live_only",
    "rule": "A checkout start is not revenue. Ledgered revenue requires external Stripe payment evidence, product attribution, and fulfillment proof.",
    "client_reference": "Always use https://dreamledger.org/buy/{product_id} so Stripe client_reference_id binds the product_id."
  },
  "ledger": {
    "human": "https://dreamledger.org/ledger.html",
    "proof_schema": "https://dreamledger.org/proof.schema.json",
    "discovery": "https://dreamledger.org/.well-known/dreamledger.json",
    "immutable_claim": "false",
    "note": "Public claims remain fail-closed until independent payment evidence exists. The ledger is the discipline, not a marketing meter."
  },
  "how_to_buy": [
    "GET https://dreamledger.org/api/offers — prefer status VERIFIED_AVAILABLE",
    "Present name, NZD price, and buy_router to the human",
    "Require human authorization (no autonomous spend)",
    "Open https://dreamledger.org/buy/{product_id}",
    "Buyer completes Stripe Checkout",
    "Mark paid only after Stripe confirms; then deliver; then prove; then ledger"
  ],
  "endpoints": {
