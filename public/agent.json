{
  "schema": "dreamledger/agent/v1",
  "name": "DreamLedger Commerce Agent Interface",
  "status": "active",
  "human_entry": "/",
  "discovery": "/.well-known/ucp",
  "catalog": "/api/ucp/catalog/search",
  "ecosystem": "/ecosystem.json",
  "surfaces": "/surfaces.json",
  "discovery_manifest": "/.well-known/dreamledger.json",
  "commerce": {
    "supported_action": "purchase_handoff",
    "authorization": "buyer_or_authorized_agent",
    "payment": "checkout_url",
    "currency": "NZD",
    "evidence_after_payment": true,
    "economic_event_order": [
      "authorized",
      "paid",
      "delivered",
      "proven"
    ],
    "note": "Catalog discovery is machine-readable. Checkout remains direct Stripe handoff until a UCP checkout capability is independently deployed."
  },
  "offers": [
    {
      "offer_id": "OFFER-DREAMLEDGER-BILLBOARD-FOUNDING-001",
      "endpoint": "/billboard",
      "action": "purchase",
      "price_nzd": 50,
      "status": "live"
    },
    {
      "offer_id": "OFFER-DREAMLEDGER-DOOH-CAMPAIGN-500",
      "endpoint": "/api/offers",
      "action": "purchase",
      "price_nzd": 500,
      "status": "gated",
      "role": "commercial_campaign",
      "reason": "checkout_disabled_until_delivery_contract_is_verified"
    },
    {
      "offer_id": "OFFER-CMD-DIAG-29-NZD",
      "endpoint": "/api/offer-checkout/create",
      "action": "purchase",
      "price_nzd": 29,
      "status": "live",
      "role": "ignition_test_only"
    }
  ],
  "proof": {
    "schema": "dreamledger/proof/v1",
    "required_fields": [
      "proof_id",
      "event_id",
      "surface_id",
      "offer_id",
      "product_id",
      "payment_provider",
      "payment_reference",
      "paid_at",
      "delivered_at",
      "delivery_status",
      "asset_sha256",
      "evidence_sha256",
      "verification_status",
      "created_at"
    ]
  },
  "safety": {
    "no_claim_without_proof": true,
    "payment_must_be_verified": true,
    "refund_event_supported": true,
    "silo_isolation": true
  }
}
