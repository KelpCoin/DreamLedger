{
  "schema": "dreamledger/discovery/v2",
  "service": "DreamLedger",
  "status": "active",
  "updated": "2026-09-21",
  "canonical": {
    "cube": "/cube.json",
    "ecosystem": "/ecosystem.json",
    "agent": "/agent.json",
    "agent_commerce": "/agent-commerce.json",
    "surfaces": "/surfaces.json",
    "offers": "/api/offers",
    "products": "/api/products",
    "market": "/",
    "proof_schema": "dreamledger/proof/v1"
  },
  "commerce": {
    "flow": ["discover", "offer", "authorize", "pay", "deliver", "prove", "ledger"],
    "scale_rule": "paid_verified_then_clone",
    "fee_policy": {
      "dreamledger_success_fee_bps": 0,
      "dreamledger_listing_fee_nzd": 0
    },
    "settlement": "stripe_live_nzd",
    "agentic_rails": {
      "live": ["stripe_payment_link"],
      "reserved": ["x402", "mpp", "escrow"]
    }
  },
  "safety": {
    "payment_authorization_required": true,
    "public_posting_approval_required": true,
    "silo_isolation_required": true,
    "verified_revenue_requires_external_proof": true
  }
}
