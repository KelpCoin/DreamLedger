{
  "aiendpoint": "1.0",
  "service": {
    "name": "DreamLedger",
    "description": "DreamLedger provides free evidence-checking tools, supplier quote comparison, and selected products and services.",
    "category": [
      "ecommerce",
      "productivity"
    ],
    "language": [
      "en-NZ"
    ]
  },
  "capabilities": [
    {
      "id": "free_truth_oracle",
      "description": "Free resource for recording a claim, tracing its original source, checking dates, and noting contradictions or missing evidence.",
      "endpoint": "https://dreamledger.org/truth-oracle.html",
      "method": "GET",
      "returns": "Public evidence-checking tool and reusable claim record."
    },
    {
      "id": "free_supplier_quote_worksheet",
      "description": "Free browser-side CSV worksheet for organising supplier quotes. Entries are not uploaded by this tool.",
      "endpoint": "https://dreamledger.org/",
      "method": "GET",
      "returns": "A downloadable local CSV template."
    },
    {
      "id": "public_research_notes",
      "description": "Source-linked research notes on AI commerce and product discovery. Notes attribute company claims and make uncertainty visible.",
      "endpoint": "https://dreamledger.org/pulse/",
      "method": "GET",
      "returns": "Curated public research notes."
    },
    {
      "id": "supplier_quote_comparison",
      "description": "One-time service for comparing 2–5 supplier quotes and identifying differences or missing information.",
      "endpoint": "https://dreamledger.org/quote-comparison/",
      "method": "GET",
      "returns": "Service details and purchase instructions."
    }
  ],
  "auth": {
    "type": "none"
  },
