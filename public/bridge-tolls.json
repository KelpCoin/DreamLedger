  "metering": {
    "authority": "Existing control_bridge_notes structured-event log via Agent Bridge proxy RPC",
    "reservation": "Atomic per-key reservation before paid work using an advisory transaction lock",
    "idempotency": "Same key and same request replays the stored response; same key with a different request is rejected",
    "exhaustion": "402 quota_exhausted before route execution",
    "dependency_failure": "503 fail-closed; checkout and redemption are blocked when durable metering health fails",
