FROM node:24-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

# Install root dependencies used by public preloads and shared scripts.
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund

# Package tracked runtime surfaces. The full canonical compile remains an
# independent release gate and currently fails closed on offer/link drift.
COPY . .
RUN npm install --prefix BEC-PRIME --omit=dev --no-audit --no-fund \
    && node -e "const fs=require('fs'); const paths=['BEC-PRIME/catalog/offers/offers.json','BEC-PRIME/catalog/offers/approved.json','BEC-PRIME/catalog/ip-capabilities.json','BEC-PRIME/compiled/website/index.html','BEC-PRIME/compiled/website/assets/marketplace-live.js']; const missing=paths.filter(p=>!fs.existsSync(p)||!fs.statSync(p).size); if(missing.length){console.error('RUNTIME_ARTIFACTS_MISSING='+missing.join(','));process.exit(1)} console.log('TRACKED_RUNTIME_ARTIFACTS=PASS:'+paths.length)" \
    && chmod 0755 ops/migration/render-exit/start.sh

ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=${GIT_COMMIT}
ENV GITHUB_SHA=${GIT_COMMIT}

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["sh", "ops/migration/render-exit/start.sh"]
