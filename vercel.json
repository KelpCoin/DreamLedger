{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "billboard-verified-release-20261027": true
    }
  },
  "buildCommand": "node scripts/verify-vercel-public-release.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "regions": [
    "syd1"
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/b2b",
      "destination": "/b2b.html"
    },
    {
      "source": "/b2b/",
      "destination": "/b2b.html"
    },
    {
      "source": "/marketplace",
      "destination": "/marketplace.html"
    },
    {
      "source": "/marketplace/",
      "destination": "/marketplace.html"
    },
    {
      "source": "/billboard",
      "destination": "/billboard.html"
    },
    {
      "source": "/billboard/",
      "destination": "/billboard.html"
    },
    {
      "source": "/api/billboard/public",
      "destination": "/api/billboard-public"
    },
    {
      "source": "/thanks",
      "destination": "/thanks.html"
    },
    {
      "source": "/thanks/",
      "destination": "/thanks.html"
    }
  ]
}
