{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel-site.js",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": { "maxDuration": 30, "memory": 1024 }
  },
  "regions": ["syd1"],
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ]
}
