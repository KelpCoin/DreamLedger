{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "buildCommand": "node scripts/verify-vercel-public-release.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "regions": [
    "syd1"
  ],
  "rewrites": [
    {
      "source": "/b2b",
      "destination": "/b2b.html"
    },
    {
      "source": "/b2b/",
      "destination": "/b2b.html"
    },
    {
      "source": "/marketplace",
      "destination": "/marketplace.html"
    },
    {
      "source": "/marketplace/",
      "destination": "/marketplace.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
