{
  "version": 2,
  "buildCommand": "npm run compile",
  "installCommand": "npm install",
  "outputDirectory": "BEC-PRIME/compiled/website",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/version",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "functions": {
    "api/billboard-stripe-webhook.js": {
      "maxDuration": 10
    }
  }
}
