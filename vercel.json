{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "node scripts/build-customer-public-release.cjs && node scripts/verify-vercel-public-release.cjs",
  "outputDirectory": "public-release",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "regions": [
    "syd1"
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/billboard",
      "destination": "/billboard.html"
    },
    {
      "source": "/billboard/",
      "destination": "/billboard.html"
    },
    {
      "source": "/avatar",
      "destination": "/avatar.html"
    },
    {
      "source": "/mtg",
      "destination": "/mtg/index.html"
    },
    {
      "source": "/ticker",
      "destination": "/ticker.html"
    }
  ]
}
