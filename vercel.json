{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {"deploymentEnabled": false},
  "buildCommand": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('index.html','public/index.html')\"",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {"maxDuration":30,"memory":1024}
  },
  "regions": ["syd1"],
  "rewrites": [
    {"source":"/","destination":"/index.html"},
    {"source":"/board","destination":"/board.html"}
  ]
}
