{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamledger.org/schemas/silo-evidence-v1.schema.json",
  "title": "DreamLedger Silo Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "silo_id",
    "evidence_id",
    "status",
    "claim",
    "source_refs",
    "sha256",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "silo-evidence-v1"
    },
    "silo_id": {
      "type": "string",
      "minLength": 2
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "CONTRADICTED",
        "STALE",
        "TEST",
        "SIMULATED",
        "INTERNAL",
        "UNMATCHED"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([0-9a-f]{64})?$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "verifier": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "verifier": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
