{
  "name": "dreamledger",
  "version": "1.4.2",
  "private": true,
  "description": "DreamLedger sovereign omni-commerce engine",
  "main": "BEC-PRIME/start.js",
  "scripts": {
    "start": "node -r ./BEC-PRIME/lib/publicShellPreload.js -r ./BEC-PRIME/lib/m2mPreload.js -r ./BEC-PRIME/lib/qrPreload.js BEC-PRIME/start.js",
    "compile": "npm run compile:products && npm run compile:commerce-api && npm run compile:offers && npm run compile:qr && npm run compile:omni && npm run compile:surface && npm run compile:mtg && npm run compile:featured-offer && npm run compile:billboard && npm run compile:board && npm run compile:molt-beach && npm run compile:price && npm run compile:public-contract && npm run compile:leverage && npm run compile:opportunities && npm run verify:ip && npm run verify:molt-beach && node BEC-PRIME/scripts/verify-public-surface.js && node BEC-PRIME/scripts/verify-silo-boundaries.js",
    "build": "npm install --no-audit --no-fund && npm run compile",
    "compile:products": "node BEC-PRIME/compiler/ProductCompiler.js",
    "compile:commerce-api": "node BEC-PRIME/compiler/CommerceApiCompiler.js",
    "compile:offers": "node BEC-PRIME/compiler/OfferCompiler.js",
    "compile:qr": "node BEC-PRIME/compiler/QRCompiler.js",
    "compile:omni": "node BEC-PRIME/compiler/OmniCommerceCompiler.js",
    "compile:surface": "node BEC-PRIME/compiler/SurfaceCompilerStable.js",
    "compile:mtg": "node BEC-PRIME/compiler/MTGCatalogCompiler.js",
    "compile:featured-offer": "node BEC-PRIME/scripts/patch-featured-offer.js",
    "compile:billboard": "node BEC-PRIME/compiler/BillboardCompiler.js",
    "compile:board": "node BEC-PRIME/compiler/BoardCompiler.js",
    "compile:molt-beach": "node BEC-PRIME/compiler/MoltBeachCompiler.js",
    "compile:price": "node BEC-PRIME/compiler/PriceDisplayPatch.js",
    "compile:public-contract": "node BEC-PRIME/compiler/PublicSurfaceContractPatch.js",
    "compile:leverage": "node BEC-PRIME/scripts/Run-CompilerLeverageGate.js",
    "compile:opportunities": "node BEC-PRIME/opportunity/OpportunityCompiler.js",
    "verify:ip": "node BEC-PRIME/scripts/verify-ip-runtime-contract.js",
    "verify:molt-beach": "node BEC-PRIME/scripts/Verify-MoltBeachMVP.js",
    "verify:silos": "node BEC-PRIME/scripts/verify-silo-boundaries.js",
    "verify:agentic-commerce": "node BEC-PRIME/scripts/verify-agentic-commerce.js",
    "verify:trust-attestation": "node BEC-PRIME/scripts/verify-trust-attestation.js",
    "verify:evidence-manifest": "node BEC-PRIME/scripts/verify-evidence-manifest.js",
    "verify:account-avatar": "node BEC-PRIME/scripts/verify-account-avatar-flow.js",
    "verify:internal-trust": "node BEC-PRIME/scripts/verify-internal-trust-service.js",
    "smoke:public": "node BEC-PRIME/scripts/first-party-smoke.js",
    "verify:production-version": "node BEC-PRIME/scripts/verify-production-version.js",
    "refine:local": "python BEC-PRIME/refinement/MultiLMRefinementEngine.py",
    "gauntlet:candidate": "node BEC-PRIME/gauntlet/CandidateGauntlet.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "ajv": "^8.17.1", "qrcode": "^1.5.4" }
}
