{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dreamledger.org/schemas/runtime/cube/factory_dashboard.schema.json",
  "title":"DreamLedger CUBE Factory Dashboard",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema",
    "scope",
    "generated_at_utc",
    "substrates_ingested",
    "candidates_generated",
    "gauntlet_survivors",
    "offers_compiled",
    "surfaces_exposed",
    "buyer_signals",
    "settled_payments",
    "fulfilled",
    "verified",
    "clones_spawned",
    "lanes"
  ],
  "properties":{
    "schema":{"const":"dreamledger/cube/factory-dashboard/v1"},
    "scope":{"type":"string","minLength":1},
    "generated_at_utc":{"type":"string","format":"date-time"},
    "substrates_ingested":{"type":"integer","minimum":0},
    "candidates_generated":{"type":"integer","minimum":0},
    "gauntlet_survivors":{"type":"integer","minimum":0},
    "offers_compiled":{"type":"integer","minimum":0},
    "surfaces_exposed":{"type":"integer","minimum":0},
    "buyer_signals":{"type":"integer","minimum":0},
    "settled_payments":{"type":"integer","minimum":0},
    "fulfilled":{"type":"integer","minimum":0},
    "verified":{"type":"integer","minimum":0},
    "clones_spawned":{"type":"integer","minimum":0},
    "lanes":{
      "type":"object",
      "minProperties":1,
      "additionalProperties":{
        "type":"object",
        "additionalProperties":false,
        "required":["status","exposures","checkouts","paid","fulfilled","verified"],
        "properties":{
          "status":{"enum":["CANDIDATE","COMPILED","EXPOSED","PAID","VERIFIED","KILLED"]},
          "exposures":{"type":"integer","minimum":0},
          "checkouts":{"type":"integer","minimum":0},
          "paid":{"type":"integer","minimum":0},
          "fulfilled":{"type":"integer","minimum":0},
          "verified":{"type":"integer","minimum":0}
        }
      }
    }
  }
}
