{
  "contract_id": "dreamledger.beck.bounded-execution.v1",
  "version": 1,
  "status": "PROPOSED",
  "purpose": "Define the fail-closed policy contract for BECK. This contract is not itself production authorization or a deployed executor.",
  "allowed_action_types": [],
  "default_decision": "DENY",
  "authority": {"required_for_all_effects": true, "accepted_states": ["APPROVED"], "must_be_unexpired": true, "must_match_intent_id": true, "must_match_action_type": true, "must_match_target": true},
  "limits": {"max_attempts": 1, "max_duration_seconds": 30, "max_api_calls": 0, "max_spend_minor_units": 0, "max_payload_bytes": 65536},
  "required_intent_fields": ["intent_id", "action_type", "target", "issued_at", "idempotency_key", "payload", "limits"],
  "required_evidence_fields": ["intent_id", "decision", "reason_codes", "contract_id", "evaluated_at", "authority_reference", "idempotency_key"],
  "critical_failures": ["INVALID_CONTRACT", "INVALID_INTENT", "AUTHORITY_MISSING", "AUTHORITY_EXPIRED", "AUTHORITY_SCOPE_MISMATCH", "ACTION_NOT_ALLOWLISTED", "TARGET_OUT_OF_SCOPE", "RESOURCE_LIMIT_EXCEEDED", "IDEMPOTENCY_CONFLICT", "EVIDENCE_WRITE_FAILED"],
  "retry_policy": {"automatic_retries": 0, "reason": "Retries are disabled until the underlying action adapter proves idempotency."},
  "truth_invariants": {"dispatch_is_not_external_send": true, "internal_result_is_not_revenue": true, "evidence_required_for_completion": true, "unknown_state_fails_closed": true}
}