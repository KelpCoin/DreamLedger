<!doctype html>
<html lang="en-NZ">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Search MTG listings · NZ · 0% fees | DreamLedger</title>
<meta name="description" content="Searchable Magic listings for New Zealand. Posts don’t disappear into a Facebook wall. 0% success fee.">
<meta name="theme-color" content="#0a0b0f">
<link rel="canonical" href="https://dreamledger.org/mtg-search">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600;9..40,700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0b0f;--surface:#161922;--ink:#f4f1ea;--muted:#9aa0b0;--dim:#6d7385;--line:#2a3040;--gold:#d4a84b;--gold-b:#e8c06a;--serif:"Instrument Serif",Georgia,serif;--sans:"DM Sans",system-ui,sans-serif;--safe:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;margin:0;padding:0}body{font-family:var(--sans);background:var(--bg);color:var(--ink);line-height:1.5;padding-bottom:calc(88px + var(--safe));-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}.wrap{max-width:720px;margin:0 auto;padding:0 16px}
.hdr{position:sticky;top:0;z-index:20;background:rgba(10,11,15,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--line);padding:12px 16px}
.hdr-inner{max-width:720px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:10px}
.brand{font-weight:700;font-size:14px}.brand em{font-family:var(--serif);font-style:italic;color:var(--gold-b);font-weight:400}
.hdr a.cta{background:linear-gradient(180deg,var(--gold-b),var(--gold));color:#14120c;font-weight:800;font-size:13px;padding:10px 14px;border-radius:999px;min-height:44px;display:inline-flex;align-items:center}
h1{font-family:var(--serif);font-size:clamp(1.8rem,5vw,2.3rem);font-weight:400;margin:20px 0 8px}
.sub{color:var(--muted);font-size:14px;margin-bottom:16px}
.pill{display:inline-block;font-size:11px;font-weight:700;color:var(--gold-b);border:1px solid rgba(212,168,75,.35);padding:4px 10px;border-radius:999px;margin-right:6px;margin-bottom:6px}
.search{display:flex;gap:8px;margin:12px 0;flex-wrap:wrap}
.search input,.search select{flex:1;min-width:120px;padding:12px 14px;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:var(--ink);font:inherit;min-height:48px}
.meta{font-size:12px;color:var(--dim);margin-bottom:12px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:16px;margin-bottom:10px}
.card h2{font-size:16px;font-weight:700;margin-bottom:4px}
.card .row{display:flex;flex-wrap:wrap;gap:8px 14px;font-size:13px;color:var(--muted);margin:8px 0}
.card .price{font-size:1.25rem;font-weight:800;color:var(--gold-b)}
.card .tag{font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
.empty{text-align:center;padding:32px 16px;color:var(--muted);border:1px dashed var(--line);border-radius:16px;margin:16px 0}
.vs{background:#12141c;border:1px solid var(--line);border-radius:16px;padding:16px;margin:20px 0;font-size:13px;color:var(--muted)}
.vs strong{color:var(--ink)}
.stick{position:fixed;left:12px;right:12px;bottom:calc(12px + var(--safe));background:#12141c;border:1px solid var(--line);border-radius:16px;padding:12px;display:flex;gap:10px;align-items:center;box-shadow:0 12px 40px rgba(0,0,0,.4)}
.stick b{flex:1;font-size:12px}.stick a{background:linear-gradient(180deg,var(--gold-b),var(--gold));color:#14120c;font-weight:800;padding:12px 16px;border-radius:999px;font-size:13px;white-space:nowrap}
</style>
</head>
<body>
<header class="hdr"><div class="hdr-inner">
  <a class="brand" href="/mtg">Dream<em>Ledger</em> · MTG</a>
  <a class="cta" href="/mtg-list">List a card</a>
</div></header>
<main class="wrap">
  <h1>Search listings</h1>
  <p class="sub">Structured. Filterable. <strong style="color:var(--ink)">Doesn’t vanish under the next post.</strong> 0% success fee on peer sales.</p>
  <span class="pill">No Facebook wall</span>
  <span class="pill">NZD + city</span>
  <span class="pill">Sell = free account</span>
  <div class="search">
    <input id="q" type="search" placeholder="Card name…" enterkeyhint="search" autocomplete="off">
    <select id="city"><option value="">All NZ</option><option>Auckland</option><option>Wellington</option><option>Christchurch</option><option>Hamilton</option><option>Dunedin</option><option>Other / post</option></select>
    <select id="cond"><option value="">Any condition</option><option>NM</option><option>LP</option><option>MP</option><option>HP</option></select>
  </div>
  <p class="meta" id="count">Loading…</p>
  <div id="list"></div>
  <div class="vs"><strong>Why this beats NZ MTG Marketplace on Facebook</strong><br>
  Their posts get buried, moderated away, or stuck behind one-post rules. Here every listing stays <strong>searchable</strong> until you mark it sold. What they still have: the crowd — we seed stock and make listing fast so the crowd has somewhere better to stand.</div>
</main>
<div class="stick"><b>Your listing won’t disappear in a feed</b><a href="/mtg-list">List free</a></div>
<script>
(function(){
var SEED=[{id:'1',name:'Sol Ring',set:'C21',condition:'NM',finish:'Nonfoil',price:4,city:'Wellington',logistics:'CBD pickup or post +$5',notes:'Have 3'},{id:'2',name:'Arcane Signet',set:'C20',condition:'NM',finish:'Nonfoil',price:3,city:'Auckland',logistics:'North Shore meetup',notes:''},{id:'3',name:'Command Tower',set:'C21',condition:'LP',finish:'Foil',price:8,city:'Christchurch',logistics:'Post tracked',notes:''},{id:'4',name:'Cultivate',set:'C21',condition:'NM',finish:'Nonfoil',price:1,city:'Wellington',logistics:'Pickup Te Aro',notes:'Bulk ok'},{id:'5',name:'Beast Within',set:'NCC',condition:'NM',finish:'Nonfoil',price:2,city:'Hamilton',logistics:'Post +$4',notes:''},{id:'6',name:'Counterspell',set:'MH2',condition:'NM',finish:'Nonfoil',price:3,city:'Auckland',logistics:'City meetup',notes:''},{id:'7',name:'Path to Exile',set:'MM2',condition:'LP',finish:'Nonfoil',price:5,city:'Wellington',logistics:'Post or Cubacade area',notes:''},{id:'8',name:'Rhystic Study',set:'PCY',condition:'MP',finish:'Nonfoil',price:35,city:'Other / post',logistics:'Tracked post only',notes:'Played, honest MP'}];
function drafts(){try{var d=JSON.parse(localStorage.getItem('dreamledger_mtg_draft_listing')||'null');if(!d||!d.card)return[];return[{id:'draft',name:d.card,set:'',condition:d.condition||'NM',finish:d.finish||'',price:Number(d.price_nzd)||0,city:d.city||'',logistics:d.logistics||'',notes:(d.notes||'')+' · your draft'}];}catch(e){return[]}}
function all(){return drafts().concat(SEED)}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;')}
function render(){var q=(document.getElementById('q').value||'').toLowerCase().trim();var city=document.getElementById('city').value;var cond=document.getElementById('cond').value;var items=all().filter(function(x){if(q&&(x.name+' '+x.set+' '+(x.notes||'')).toLowerCase().indexOf(q)<0)return false;if(city&&x.city!==city)return false;if(cond&&x.condition!==cond)return false;return true;});document.getElementById('count').textContent=items.length+' listing'+(items.length===1?'':'s')+' · filter anytime';var root=document.getElementById('list');if(!items.length){root.innerHTML='<div class="empty">No matches. <a href="/mtg-list" style="color:var(--gold-b)">List this card →</a></div>';return;}root.innerHTML=items.map(function(x){return '<article class="card"><div class="tag">'+(x.id==='draft'?'YOUR DRAFT':'LISTING')+'</div><h2>'+esc(x.name)+(x.set?' · '+esc(x.set):'')+'</h2><div class="row"><span>'+esc(x.condition)+' · '+esc(x.finish)+'</span><span>'+esc(x.city)+'</span></div><div class="price">NZ$'+esc(x.price)+'</div><div class="row">'+esc(x.logistics)+'</div>'+(x.notes?'<div class="row">'+esc(x.notes)+'</div>':'')+'</article>';}).join('');}
['q','city','cond'].forEach(function(id){document.getElementById(id).addEventListener('input',render);document.getElementById(id).addEventListener('change',render);});render();
})();
</script>
</body>
</html>
