    "maximum_live_workers_before_all_gates_pass": 1,
    "configured_ceiling_workers": 64,
    "epv_floor_nzd": 25,
    "winner_expansion_threshold_nzd": 120,
    "queue_scaling_rule": "one worker per 10 pending qualified signals only in the normal EPV band after the execution provider and durable queue are verified",
    "expansion_rule": "double workers only when trailing measured net contribution EPV is at least NZ$120, there is positive net contribution after refunds/provider/fulfillment costs, and sample/queue/budget gates pass",
    "pruning_rule": "when measured net contribution EPV is below NZ$25, reduce a connected pool to one maintenance worker; do not simulate that a worker was stopped if no pool is deployed",
    "epv_definition": "settled attributed revenue minus refunds, payment processing, delivery and other variable costs, divided by unique qualified visitors over the measurement window",
    "minimum_independent_settled_and_fulfilled_transactions_before_expansion": 20,
    "measurement_window_days": 30,
    "no_scale_from_pipeline_value": true,
    "simulation_counts_as_revenue": false,
    "scale_requires": [
      "durable live queue",
      "actual worker runtime and health telemetry",
      "independent settled and fulfilled transactions",
      "per-silo tenant boundary tests",
      "idempotent retry tests",
      "budget cap",
      "rollback path",
      "signed settlement-and-fulfillment reconciliation attestation",
      "verified ledger and reconciliation SHA-256 digests",
      "HMAC key held outside repository",
      "decision-only output reviewed before any independently authorized worker mutation"
    ],
    "policy_note": "The thresholds 25/120/64 originate from the requested strategy, not from independent runtime validation. Automatic scaling remains disabled until live worker code and economic inputs are verified.",
    "decision_gate_path": "ops/economic/cube_epv_gate.py",
    "signed_evidence_required": true,
    "attestation_algorithm": "HMAC-SHA256 from trusted reconciler; key supplied via CUBE_ECONOMIC_EVIDENCE_HMAC_KEY",
    "decision_engine_side_effects": false
