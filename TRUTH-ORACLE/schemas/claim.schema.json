{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TRUTH-ORACLE/schemas/claim.schema.json",
  "title": "Truth Oracle Claim",
  "type": "object",
  "required": ["claim_id", "title", "domain", "statement", "geographic_scope", "verification_status", "evidence"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "enum": ["electricity", "groceries", "fuel", "internet", "mobile", "insurance", "household", "subscriptions", "banking", "statistics"]},
    "statement": {"type": "string", "minLength": 1},
    "geographic_scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "verification_status": {"type": "string", "enum": ["VERIFIED", "STALE", "CONTRADICTED", "MISSING"]},
    "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contradiction_log": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "commercial_links": {"type": "array", "items": {"type": "object", "required": ["label", "href"], "properties": {"label": {"type": "string"}, "href": {"type": "string"}}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source", "source_url", "observed_at", "evidence_hash"], "properties": {"source": {"type": "string"}, "source_url": {"type": "string"}, "observed_at": {"type": "string", "format": "date-time"}, "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "notes": {"type": "string"}}}}
  },
  "additionalProperties": false
}
