{
  "schema": "BEC-PRIME/CUBE-CLONE-MANIFEST/v1",
  "source_contract": "BEC-PRIME/cube/CUBE-CLONE-CONTRACT.json",
  "factory_contract": "BEC-PRIME/cube/CUBE-SILO-FACTORY-CONTRACT.json",
  "slug": "mtg",
  "name": "Magic: The Gathering",
  "short": "Magic",
  "tagline": "Singles and decks — see the cards, then deal.",
  "accent": "#a9f2d0",
  "accent_bright": "#a9f2d0",
  "route": "/mtg/",
  "list_route": "/mtg-list",
  "catalog": "/data/mtg-catalog.json",
  "manifest_path": "/silos/mtg/silo.json",
  "neutral_host": "dreamledger",
  "status": "live_candidate",
  "isolation": {
    "catalog": true,
    "checkout": true,
    "analytics": true,
    "customer_data": true,
    "content": true,
    "promotion": true
  },
  "capabilities_by_ref": [
    "catalog",
    "gauntlet",
    "commerce-spine",
    "news-carousel",
    "fossil"
  ],
  "inventory_policy": "empty_until_verified_supply",
  "payment_truth": "settled_payment_only",
  "browse_free": true,
  "account_to_sell": true,
  "success_fee_peer": 0,
  "currency": "NZD",
  "listing_template_ref": "AGENT_BUS/SILOS/MTG-LISTING-TEMPLATE.md",
  "listing_fields_required": [
    "title",
    "condition",
    "finish",
    "price_nzd",
    "city",
    "meetup_or_post"
  ],
  "listing_fields_optional": [
    "photos",
    "language",
    "quantity",
    "bundle_discount",
    "trades_wanted"
  ],
  "product_kinds": [
    {
      "id": "single",
      "label": "Single",
      "primary": true
    },
    {
      "id": "commander-deck",
      "label": "Commander deck",
      "detail_pattern": "/mtg/{slug}.html",
      "grid_capability": "card_image_grid"
    }
  ],
  "clone": {
    "rule": "Clone shell + capability bindings. Never copy inventory. Never invent templates outside factory.",
    "steps": [
      "Copy public/silos/mtg/silo.json to public/silos/{slug}/silo.json",
      "Set slug, name, short, accent, routes, catalog path",
      "Create empty catalog public/data/{slug}-catalog.json with products: []",
      "Point public/{slug}/index.html at silo-master.css + new manifest path",
      "Cube compile_candidate then gauntlet_check then publish_approval_gate",
      "Activate only with verified supply atom and buyer path"
    ],
    "replace_tokens": {
      "{{SILO_SLUG}}": "slug",
      "{{SILO_NAME}}": "name",
      "{{SILO_SHORT}}": "short",
      "{{SILO_TAGLINE}}": "tagline",
      "{{SILO_ACCENT}}": "accent",
      "{{SILO_ROUTE}}": "route",
      "{{SILO_LIST_ROUTE}}": "list_route",
      "{{SILO_CATALOG}}": "catalog"
    },
    "do_not_copy": [
      "product inventory rows",
      "customer data",
      "stripe credentials",
      "analytics identities",
      "other silo promotion"
    ]
  },
  "gauntlet": {
    "accept_when": [
      "manifest validates against clone schema",
      "catalog empty or every product has verified supply fields",
      "list path works without cross-silo data",
      "no revenue claim without settled payment evidence",
      "public copy has no internal control-plane language"
    ],
    "reject_when": [
      "inventory invented without supply atom",
      "cross-silo customer or catalog bleed",
      "template invented outside factory contracts",
      "activation without publish_approval_gate"
    ]
  },
  "surface": {
    "hero_pills": [
      "Browse without a login",
      "0% peer success fee",
      "Reuse existing references"
    ],
    "primary_cta": {
      "label": "Prepare a free listing",
      "href_key": "list_route"
    },
    "secondary_cta": {
      "label": "Browse decks",
      "href": "#decks"
    },
    "community_blocks": [
      {
        "title": "Browse without joining a discussion",
        "body": "Open listings and deck pages. You do not need an account or a forum post just to explore."
      },
      {
        "title": "Bring listings and references",
        "body": "Paste an existing card listing or link reference posts in a private draft. No scraping or automatic publication."
      },
      {
        "title": "Reputation needs evidence",
        "body": "External profile references are labelled unverified. Verified transaction feedback requires independent buyer, settlement and delivery proof."
      }
    ],
    "external_reference_policy": {
      "mode": "PRIVATE_DRAFT_ONLY",
      "verified_transaction_credit": 0,
      "expose_public_score_without_proof": false,
      "external_scraping": false
    }
  }
}
