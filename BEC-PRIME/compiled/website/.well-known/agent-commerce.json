{
  "schema": "dreamledger/agent-commerce/v3",
  "updated": "2026-10-08",
  "purpose": "Machine-readable B2B and agent-commerce contract for discovery, comparison and authorized checkout.",
  "marketplace": {
    "human": "https://dreamledger.org/marketplace.html",
    "b2b": "https://dreamledger.org/b2b",
    "machine_contract": "https://dreamledger.org/.well-known/dreamledger-marketplace.json"
  },
  "capabilities": [
    "discover_b2b_supply",
    "discover_checkout_ready_offers",
    "compare_opportunities",
    "handoff_to_human_authorization",
    "follow_existing_stripe_checkout"
  ],
  "endpoints": {
    "marketplace_snapshot": "https://dreamledger.org/api/b2b/marketplace",
    "offers": "https://dreamledger.org/api/offers",
    "products": "https://dreamledger.org/api/products",
    "commerce_contract": "https://dreamledger.org/agent-commerce.json",
    "marketplace_contract": "https://dreamledger.org/.well-known/dreamledger-marketplace.json"
  },
  "authorization": {
    "required": [
      "identity",
      "consent",
      "payment",
      "external_account_actions"
    ],
    "autonomous_spend": false
  },
  "truth_boundary": "Discovery, listing, checkout creation and order creation are not revenue. VERIFIED requires independent external settlement plus attribution, fulfillment and evidence.",
  "monetization": [
    "direct_offer_checkout",
    "quote_comparison",
    "verified_evidence_access",
    "agent_calls",
    "seller_tools",
    "promoted_discovery"
  ],
  "fee_policy": {
    "marketplace_success_fee_bps": 0,
    "processor": "Stripe",
    "note": "Optional paid tools and processor fees are separate and disclosed."
  }
}
