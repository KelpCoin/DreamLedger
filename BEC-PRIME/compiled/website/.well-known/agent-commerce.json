{
  "schema": "dreamledger/agent-commerce/v2",
  "service": "DreamLedger",
  "silo": "dreamledger",
  "currency": "NZD",
  "offer_catalog": "/api/offers",
  "offer_lookup": "/api/offers/{offer_id}",
  "checkout": "/api/offer-checkout/create",
  "approval_model": "explicit_human_approval",
  "offers_are_checkout_disabled_by_default": true,
  "capabilities": null,
  "private_material": "excluded",
  "source_of_truth": "/api/offers",
  "agent_contract": {
    "discover": "GET /api/offers",
    "inspect": "GET /api/offers/{offer_id}",
    "request_checkout": "POST /api/offer-checkout/create",
    "checkout_requires_server_approval": true,
    "client_supplied_price_is_ignored": true,
    "client_supplied_inventory_is_ignored": true
  },
  "supported_agent_actions": [
    "discover_offers",
    "inspect_offer",
    "request_approved_checkout"
  ],
  "not_exposed": [
    "internal_capability_catalog",
    "compiler_source",
    "gauntlet_rules",
    "private_prompts",
    "private_implementation_details",
    "secrets",
    "internal_ledger_records"
  ]
}
