{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "DreamLedger shared comfort-first enterprise grid tokens. MTG identity accents remain owned by the silo manifest.",
  "color": {
    "$type": "color",
    "surface": {
      "base": { "$value": { "colorSpace": "srgb", "components": [0.0706, 0.0706, 0.0706], "alpha": 1, "hex": "#121212" } },
      "raised": { "$value": { "colorSpace": "srgb", "components": [0.102, 0.102, 0.102], "alpha": 1, "hex": "#1A1A1A" } },
      "overlay": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.0392, 0.0392], "alpha": 1, "hex": "#0A0A0A" } }
    },
    "text": {
      "primary": { "$value": { "colorSpace": "srgb", "components": [0.9137, 0.9137, 0.9137], "alpha": 1, "hex": "#E9E9E9" } },
      "secondary": { "$value": { "colorSpace": "srgb", "components": [0.7176, 0.7176, 0.7176], "alpha": 1, "hex": "#B7B7B7" } },
      "muted": { "$value": { "colorSpace": "srgb", "components": [0.5725, 0.5725, 0.5725], "alpha": 1, "hex": "#929292" } },
      "on-accent": { "$value": { "colorSpace": "srgb", "components": [0.0275, 0.0824, 0.051], "alpha": 1, "hex": "#07150D" } }
    },
    "border": {
      "default": { "$value": { "colorSpace": "srgb", "components": [0.1882, 0.1882, 0.1882], "alpha": 1, "hex": "#303030" } },
      "subtle": { "$value": { "colorSpace": "srgb", "components": [0.149, 0.149, 0.149], "alpha": 1, "hex": "#262626" } },
      "interactive": { "$value": { "colorSpace": "srgb", "components": [0.2392, 0.7098, 0.4627], "alpha": 1, "hex": "#3DB576" } }
    },
    "accent": {
      "primary": { "$value": { "colorSpace": "srgb", "components": [0.2392, 0.7098, 0.4627], "alpha": 1, "hex": "#3DB576" } },
      "light": { "$value": { "colorSpace": "srgb", "components": [0.4471, 0.8902, 0.6784], "alpha": 1, "hex": "#72E3AD" } }
    }
  },
  "spacing": {
    "$type": "dimension",
    "space-1": { "$value": { "value": 4, "unit": "px" } },
    "space-2": { "$value": { "value": 8, "unit": "px" } },
    "space-3": { "$value": { "value": 12, "unit": "px" } },
    "space-4": { "$value": { "value": 16, "unit": "px" } },
    "space-6": { "$value": { "value": 24, "unit": "px" } },
    "space-8": { "$value": { "value": 32, "unit": "px" } },
    "space-12": { "$value": { "value": 48, "unit": "px" } },
    "space-16": { "$value": { "value": 64, "unit": "px" } }
  },
  "typography": {
    "font-family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] }
    },
    "font-size": {
      "$type": "dimension",
      "caption": { "$value": { "value": 12, "unit": "px" } },
      "body-sm": { "$value": { "value": 14, "unit": "px" } },
      "body": { "$value": { "value": 16, "unit": "px" } },
      "h4": { "$value": { "value": 18, "unit": "px" } },
      "h3": { "$value": { "value": 20, "unit": "px" } },
      "h2": { "$value": { "value": 24, "unit": "px" } },
      "h1": { "$value": { "value": 32, "unit": "px" } },
      "display": { "$value": { "value": 40, "unit": "px" } }
    },
    "font-weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.65 }
    }
  },
  "border": {
    "radius": {
      "$type": "dimension",
      "sm": { "$value": { "value": 4, "unit": "px" } },
      "md": { "$value": { "value": 8, "unit": "px" } },
      "lg": { "$value": { "value": 12, "unit": "px" } }
    },
    "width": {
      "$type": "dimension",
      "hairline": { "$value": { "value": 1, "unit": "px" } },
      "strong": { "$value": { "value": 2, "unit": "px" } }
    }
  },
  "layout": {
    "container": {
      "max": { "$type": "dimension", "$value": { "value": 1200, "unit": "px" } }
    },
    "grid": {
      "min-card": { "$type": "dimension", "$value": { "value": 240, "unit": "px" } }
    }
  }
}
