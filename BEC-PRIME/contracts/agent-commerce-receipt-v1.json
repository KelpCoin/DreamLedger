{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamledger.org/contracts/agent-commerce-receipt-v1.json",
  "title": "DreamLedger Agent Commerce Receipt v1",
  "description": "Neutral evidence record for an agent-mediated economic action. DreamLedger attests to recorded evidence and verification checks; it is not the payment rail or settlement authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "schema",
    "created_at",
    "principal",
    "agent",
    "authorization",
    "action",
    "execution",
    "economic_event",
    "provenance",
    "verification"
  ],
  "properties": {
    "receipt_id": { "type": "string", "minLength": 1 },
    "schema": { "const": "dreamledger/acr/v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "type": "string" } }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "model_family": { "type": "string" },
        "runtime": { "type": "string" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "decision"],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["ALLOW", "DENY"] },
        "delegation_id": { "type": ["string", "null"] },
        "max_amount_minor": { "type": ["integer", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"] }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "merchant_id", "product_id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "merchant_id": { "type": "string", "minLength": 1 },
        "product_id": { "type": "string", "minLength": 1 },
        "offer_id": { "type": ["string", "null"] }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "toolchain": { "type": ["string", "null"] },
        "runtime": { "type": ["string", "null"] }
      }
    },
    "economic_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "transaction_id", "amount_minor", "currency", "payment_rail"],
      "properties": {
        "event_type": { "type": "string", "minLength": 1 },
        "transaction_id": { "type": "string", "minLength": 1 },
        "amount_minor": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "minLength": 3 },
        "payment_rail": { "type": "string", "minLength": 1 },
        "settlement_reference": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_hash", "input_hash", "output_hash"],
      "properties": {
        "intent_hash": { "type": "string", "minLength": 1 },
        "input_hash": { "type": "string", "minLength": 1 },
        "output_hash": { "type": "string", "minLength": 1 },
        "previous_receipt_id": { "type": ["string", "null"] }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gauntlet", "stamp_algorithm", "claims_scope"],
      "properties": {
        "gauntlet": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "stamp_algorithm": { "const": "SHA-256" },
        "stamp": { "type": ["string", "null"] },
        "signature": { "type": ["string", "null"] },
        "claims_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
