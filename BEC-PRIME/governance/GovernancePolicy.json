{
  "schema_version": "DL-GOVERNANCE-POLICY-1.0",
  "policy_version": "1.0.0",
  "default": "DENY",
  "garage": {
    "required_for_external_side_effects": true,
    "minimum_hold_hours": 24,
    "promotion_requires_fresh_authorization": true,
    "staging_has_no_external_credentials": true
  },
  "canary": {
    "enabled": true,
    "control_percent": 90,
    "treatment_percent": 10,
    "auto_promote": false,
    "auto_rollback_on_trip": true
  },
  "kill_switch": {
    "default_state": "ARMED",
    "fail_closed": true,
    "automatic_trip_conditions": [
      "policy_violation",
      "authorization_anomaly",
      "unexpected_external_effect",
      "verification_contradiction",
      "runaway_activity",
      "blast_radius_exceeded"
    ]
  },
  "blast_radius": {
    "max_spend_nzd": 0,
    "max_recipients": 10,
    "max_external_actions": 1,
    "max_runtime_minutes": 30
  },
  "authorization": {
    "default": "DENY",
    "external_actions": ["publish", "send", "purchase", "refund", "delete", "credential_access"],
    "require_transition_id": true,
    "require_policy_version": true,
    "require_expiry": true,
    "require_explicit_capability": true
  },
  "learning": {
    "allow_unverified_experience": true,
    "allow_unverified_experience_to_change_policy": false,
    "verified_outcome_required_for_durable_learning": true
  }
}
