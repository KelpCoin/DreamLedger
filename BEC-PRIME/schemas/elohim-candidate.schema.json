{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamledger.org/schemas/elohim-candidate.schema.json",
  "title": "Elohim created candidate",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "schema_version", "status", "silo", "name", "price_proposal_nzd", "checkout_available", "approval_required"],
  "properties": {
    "id": { "type": "string", "minLength": 8 },
    "schema_version": { "type": "string" },
    "status": { "type": "string" },
    "silo": {
      "type": "string",
      "enum": ["mtg", "crypto", "media_music", "digital_products", "dreamledger"]
    },
    "name": { "type": "string", "minLength": 2 },
    "price_proposal_nzd": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 }
    },
    "price_status": { "type": "string" },
    "checkout_available": { "type": "boolean" },
    "approval_required": { "type": "boolean" },
    "payment_adapter": { "type": "string" },
    "created_by": { "const": "ELOHIM" }
  }
}
