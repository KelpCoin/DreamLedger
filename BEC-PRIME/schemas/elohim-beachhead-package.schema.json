{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamledger.org/schemas/elohim-beachhead-package.schema.json",
  "title": "Elohim-first silo beachhead package",
  "description": "Candidate-generation contract only. Validity does not authorize a live offer or public release. artifact_sha256 is computed over canonical JSON with artifact_sha256 omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "version", "created_by", "status", "silo_id", "source_signals", "buyer_hypothesis", "offer", "economics", "isolation", "risk_policy", "acceptance", "release", "provenance", "artifact_sha256"],
  "properties": {
    "schema_version": { "const": "bec.elohim-beachhead-package.v1" },
    "package_id": { "type": "string", "pattern": "^ELOHIM-[A-Z0-9._-]{6,120}$" },
    "version": { "type": "integer", "minimum": 1 },
    "created_by": { "const": "ELOHIM" },
    "status": { "enum": ["CANDIDATE", "READY_FOR_GAUNTLET", "QUARANTINED", "SUPERSEDED"] },
    "silo_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$" },
    "source_signals": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_ref", "observed_at", "signal_type"],
        "properties": {
          "source_ref": { "type": "string", "minLength": 8, "maxLength": 2000 },
          "observed_at": { "type": "string", "format": "date-time" },
          "signal_type": { "enum": ["BUYER_REQUEST", "SUPPLIER_SIGNAL", "PUBLIC_DATA", "COMPETITOR_OBSERVATION", "INTERNAL_HYPOTHESIS"] },
          "notes": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "buyer_hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["buyer", "problem", "acquisition_hypothesis"],
      "properties": {
        "buyer": { "type": "string", "minLength": 3, "maxLength": 500 },
        "problem": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "acquisition_hypothesis": { "type": "string", "minLength": 8, "maxLength": 2000 }
      }
    },
    "offer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "deliverable", "scope", "price_status", "publication_status"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 200 },
        "deliverable": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "scope": { "type": "string", "minLength": 8, "maxLength": 4000 },
        "price_proposal_nzd": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 }, "minItems": 1, "maxItems": 20 },
        "price_status": { "enum": ["UNVERIFIED", "RESEARCH_HYPOTHESIS", "EXISTING_AUTHORIZED_OFFER"] },
        "canonical_offer_ref": { "type": ["string", "null"], "maxLength": 1000 },
        "publication_status": { "const": "NOT_PUBLISHED" }
      }
    },
    "economics": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "cost_status", "margin_status", "spend_authorized"],
      "properties": {
        "currency": { "const": "NZD" },
        "cost_status": { "enum": ["UNKNOWN", "ESTIMATED", "MEASURED"] },
        "variable_cost_nzd": { "type": ["number", "null"], "minimum": 0 },
        "margin_status": { "enum": ["UNKNOWN", "UNVERIFIED", "POSITIVE_MEASURED", "NEGATIVE_MEASURED"] },
        "spend_authorized": { "const": false }
      }
    },
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["unique_silo_id", "separate_catalog", "separate_permissions", "cross_silo_customer_data"],
      "properties": {
        "unique_silo_id": { "const": true },
        "separate_catalog": { "const": true },
        "separate_permissions": { "const": true },
        "cross_silo_customer_data": { "const": false },
        "inherits_mtg_fee_policy": { "const": false }
      }
    },
    "risk_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["rights_review", "privacy_review", "claims_review", "human_release_gate"],
      "properties": {
        "rights_review": { "enum": ["PENDING", "PASS", "FAIL"] },
        "privacy_review": { "enum": ["PENDING", "PASS", "FAIL"] },
        "claims_review": { "enum": ["PENDING", "PASS", "FAIL"] },
        "human_release_gate": { "const": true }
      }
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["test_contract_ref", "required_tests", "failure_mode"],
      "properties": {
        "test_contract_ref": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "required_tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3, "maxLength": 200 } },
        "failure_mode": { "const": "FAIL_CLOSED_AND_QUARANTINE" }
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["preview_allowed", "production_allowed", "approval_ref"],
      "properties": {
        "preview_allowed": { "type": "boolean" },
        "production_allowed": { "const": false },
        "approval_ref": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit", "generator_version", "created_at"],
      "properties": {
        "source_commit": { "type": "string", "minLength": 7, "maxLength": 100 },
        "generator_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
