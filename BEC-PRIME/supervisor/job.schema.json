{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamledger.org/schemas/bec-supervisor/job/1.0.0",
  "title": "BEC Supervisor Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "created_at", "request", "objective", "silo", "priority", "approval_required", "execution_status", "expected_output", "proof_path", "verifier"],
  "properties": {
    "job_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "request": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "silo": { "type": "string", "minLength": 1 },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "required_tools": { "type": "array", "items": { "type": "string" } },
    "approval_required": { "type": "boolean" },
    "execution_status": { "type": "string", "enum": ["READY", "RUNNING", "DONE", "FAILED", "QUARANTINED"] },
    "expected_output": { "type": "string", "minLength": 1 },
    "proof_path": { "type": "string", "minLength": 1 },
    "verifier": { "type": "string", "minLength": 1 },
    "command": { "type": "string" }
  }
}
