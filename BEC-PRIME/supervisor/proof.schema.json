{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamledger.org/schemas/bec-supervisor/proof/1.0.0",
  "title": "BEC Supervisor Proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["proof_version", "job_id", "generated_at", "status", "action", "proof_path"],
  "properties": {
    "proof_version": { "type": "string", "const": "1.0.0" },
    "job_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
    "action": { "type": "string", "minLength": 1 },
    "proof_path": { "type": "string", "minLength": 1 },
    "verifier": { "type": "string" },
    "exit_code": { "type": "integer" },
    "message": { "type": "string" }
  }
}
