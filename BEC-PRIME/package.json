{
  "name": "dreamledger",
  "version": "1.6.1",
  "description": "DreamLedger sovereign omni-commerce engine",
  "main": "server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node -r ./lib/authRuntimePreload.js start.js",
    "build": "npm run compile",
    "test": "node --test scripts/test-mvp-policy.js",
    "verify:evidence": "node scripts/verify-mvp-evidence.js",
    "compile": "node scripts/write-build-metadata.js && npm run compile:products && npm run compile:offers && npm run compile:qr && npm run compile:omni && npm run compile:economic && npm run compile:surface && npm run compile:board && npm run compile:molt-beach && node scripts/EnsureAccountVerificationSurface.js && npm run compile:price && npm run compile:public-contract && npm run compile:silos && npm run compile:featured-offer && node scripts/verify-public-surface.js",
    "compile:products": "node compiler/ProductCompiler.js",
    "compile:offers": "node compiler/OfferCompiler.js",
    "compile:qr": "node compiler/QRCompiler.js",
    "compile:omni": "node compiler/OmniCommerceCompiler.js",
    "compile:economic": "node compiler/Compile-EconomicTrees.js",
    "compile:surface": "node compiler/SurfaceCompiler.js",
    "compile:board": "node compiler/BoardCompiler.js",
    "compile:molt-beach": "node compiler/MoltBeachCompiler.js",
    "compile:featured-offer": "node scripts/patch-featured-offer.js",
    "compile:price": "node compiler/PriceDisplayPatch.js",
    "compile:public-contract": "node compiler/PublicSurfaceContractPatch.js",
    "compile:silos": "node compiler/SiloPortfolioCompiler.js",
    "compile:universal": "node scripts/Smoke-UniversalCompiler.js",
    "verify:silos": "node scripts/verify-silo-boundaries.js",
    "verify:integration": "node scripts/verify-commercial-integration.js",
    "integration-truth": "node scripts/integration-truth.js",
    "verify:economic-contract": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Verify-EconomicContract.ps1",
    "refine:iterative": "node scripts/iterative-refinement.js",
    "smoke:dreamiez": "node scripts/smoke-dreamiez.js",
    "smoke:front-door": "node scripts/smoke-front-door.js",
    "smoke:revenue-ledger": "node scripts/smoke-revenue-ledger.js",
    "smoke:production": "node scripts/smoke-production.js",
    "smoke:persistent-chat": "node scripts/smoke-persistent-chat.js",
    "smoke:autonomy": "node scripts/smoke-autonomy.js",
    "smoke:worker": "node scripts/smoke-worker-pool.js",
    "runtime:verify": "node scripts/Verify-Runtime.js",
    "worker:enqueue": "node runtime/worker-pool.js enqueue",
    "worker:run": "node runtime/worker-pool.js run-once",
    "worker:list": "node runtime/worker-pool.js list",
    "worker:route": "node runtime/worker-pool.js route",
    "worker:verify": "node scripts/Verify-WorkerPool.js",
    "worker:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Run-WorkerPool.ps1",
    "worker:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Bootstrap-WindowsWorker.ps1",
    "autonomy:cycle": "node autonomy/RevenueAutonomy.js",
    "autonomy:macro": "node macro/MacroEngine.js",
    "autonomy:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-Autonomy.ps1",
    "autonomy:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Verify-Autonomy.ps1",
    "activate:first-revenue": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Activate-FirstRevenue.ps1",
    "kelplantis:health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Run-Kelplantis.ps1 -HealthOnly",
    "kelplantis:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Run-Kelplantis.ps1",
    "kelplantis:test": "node compiler/kelplantis/KelplantisFloorProfiles.test.js && node compiler/kelplantis/KelplantisHistory.test.js && node compiler/kelplantis/KelplantisDungeonGenerator.test.js",
    "kelplantis:browser": "playwright test scripts/KelplantisBrowserSmoke.spec.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
