{
  "name": "dreamledger",
  "version": "1.0.0",
  "description": "BEC-PRIME DreamLedger web service",
  "main": "server.js",
  "scripts": {
    "start": "node compiler/OfferCompiler.js && node compiler/SurfaceCompiler.js && node compiler/SiloPortfolioCompiler.js && node compiler/PriceDisplayPatch.js && node start.js",
    "compile:offers": "node compiler/OfferCompiler.js",
    "compile:surface": "node compiler/SurfaceCompiler.js && node compiler/SiloPortfolioCompiler.js && node compiler/PriceDisplayPatch.js",
    "compile:silos": "node compiler/SiloPortfolioCompiler.js",
    "smoke:dreamiez": "node scripts/smoke-dreamiez.js",
    "smoke:revenue-ledger": "node scripts/smoke-revenue-ledger.js",
    "gauntlet": "node scripts/meta-gauntlet.js",
    "activate:first-revenue": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Activate-FirstRevenue.ps1",
    "kelplantis:health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Run-Kelplantis.ps1 -HealthOnly",
    "kelplantis:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Run-Kelplantis.ps1"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
