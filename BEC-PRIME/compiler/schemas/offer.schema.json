{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamledger.org/schemas/bec-prime-offer-v1.json",
  "type": "object",
  "required": ["offer_id", "version", "capability_id", "name", "problem", "input", "output", "delivery_mechanism", "deliverable", "target_buyer", "eligibility", "constraints", "price", "currency", "refund_rules", "payment_adapter", "checkout_route", "approval_required", "checkout_available", "status", "proof_of_delivery", "verification_rules", "provenance"],
  "properties": {
    "offer_id": { "type": "string", "minLength": 1 },
    "version": { "const": "offer-v1" },
    "capability_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 1 },
    "input": { "type": "string", "minLength": 1 },
    "output": { "type": "string", "minLength": 1 },
    "delivery_mechanism": { "type": "string", "minLength": 1 },
    "deliverable": { "type": "string", "minLength": 1 },
    "target_buyer": { "type": "string", "minLength": 1 },
    "eligibility": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "price": { "type": "number", "exclusiveMinimum": 0 },
    "currency": { "const": "NZD" },
    "refund_rules": { "type": "string", "minLength": 1 },
    "payment_adapter": { "const": "stripe" },
    "checkout_route": { "const": "/api/checkout/create" },
    "approval_required": { "const": true },
    "checkout_available": { "const": false },
    "status": { "const": "candidate" },
    "proof_of_delivery": { "type": "string", "minLength": 1 },
    "verification_rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "provenance": { "type": "object", "required": ["capability_ids", "methodology", "public_claims_source", "private_material"], "properties": { "capability_ids": { "type": "array" }, "methodology": { "type": "string" }, "public_claims_source": { "type": "string" }, "private_material": { "const": "excluded" } } }
  },
  "additionalProperties": true
}
