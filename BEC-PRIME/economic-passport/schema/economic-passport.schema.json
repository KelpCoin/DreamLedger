{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamledger.org/schemas/economic-passport/1.0.0",
  "title": "BEC Economic Passport",
  "description": "Machine-readable commercial contract for a BEC SKU. passport_status describes lifecycle and listability; it does not imply truth_status.",
  "type": "object",
  "additionalProperties": false,
  "required": ["passport_version", "passport_id", "issued_at", "issued_by", "passport_status", "commercial_truth", "authority", "execution", "evidence", "transition_log"],
  "properties": {
    "passport_version": { "type": "string", "const": "1.0.0" },
    "passport_id": { "type": "string", "pattern": "^EP-[A-Z0-9-]+$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "issued_by": { "type": "string", "minLength": 1 },
    "supersedes": { "type": "string", "pattern": "^EP-[A-Z0-9-]+$" },
    "passport_status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "SUSPENDED", "EXPIRED", "REVOKED"] },
    "commercial_truth": {
      "type": "object", "additionalProperties": false,
      "required": ["sku", "product_name", "product_summary", "owner", "seller", "price_nzd", "billing"],
      "properties": {
        "sku": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,99}$" },
        "product_name": { "type": "string", "minLength": 1 },
        "product_summary": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/party" },
        "seller": { "$ref": "#/$defs/party" },
        "price_nzd": { "type": "number", "exclusiveMinimum": 0 },
        "billing": { "type": "string", "enum": ["ONE_TIME", "RECURRING", "USAGE", "CUSTOM"] }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["resale_allowed", "territory", "resale_price_policy", "resale_price_nzd", "reseller_margin"],
      "properties": {
        "resale_allowed": { "type": "boolean" },
        "territory": { "type": "object", "additionalProperties": false, "required": ["scope"], "properties": { "scope": { "type": "string", "minLength": 1 } } },
        "resale_price_policy": { "type": "string", "enum": ["FIXED", "RANGE", "FREE"] },
        "resale_price_nzd": { "type": "number", "exclusiveMinimum": 0 },
        "resale_price_floor_nzd": { "type": "number", "exclusiveMinimum": 0 },
        "resale_price_ceiling_nzd": { "type": "number", "exclusiveMinimum": 0 },
        "reseller_margin": {
          "type": "object", "additionalProperties": false, "required": ["type", "amount_nzd"],
          "properties": { "type": { "type": "string", "enum": ["FIXED", "PERCENT", "NONE"] }, "amount_nzd": { "type": "number", "minimum": 0 } }
        },
        "reseller_rights": { "type": "array", "items": { "type": "string" } },
        "restrictions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["fulfilment_method", "fulfilment_trigger", "fulfilment_window_hours", "dependencies"],
      "properties": {
        "fulfilment_method": { "type": "string", "minLength": 1 },
        "fulfilment_trigger": { "type": "string", "minLength": 1 },
        "fulfilment_window_hours": { "type": "number", "exclusiveMinimum": 0 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "deployment_mode": { "type": "string", "enum": ["ONLINE", "LOCAL", "OFFLINE", "AIR_GAPPED", "PHYSICAL", "HYBRID"] },
        "support": { "type": "string" },
        "refund_rule": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["requirements", "verification_rule", "truth_status", "provenance"],
      "properties": {
        "requirements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "verification_rule": { "type": "string", "pattern": "^[a-z0-9_]+$", "minLength": 1 },
        "truth_status": { "type": "string", "enum": ["UNVERIFIED", "VERIFIED", "CONTRADICTED", "STALE", "CONFLICTED"] },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
      }
    },
    "transition_log": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["at", "from", "to", "reason", "actor"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "from": { "type": ["string", "null"] },
          "to": { "type": "string", "enum": ["DRAFT", "ACTIVE", "SUSPENDED", "EXPIRED", "REVOKED"] },
          "reason": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "party": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["claim", "source", "observed_at", "method"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "method": { "type": "string", "minLength": 1 },
        "result": { "type": "string" }
      }
    }
  }
}