{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamledger.org/schemas/economic-passport/1.0.0",
  "title": "BEC Economic Passport",
  "description": "Machine-readable commercial identity, authority, execution and evidence contract for a BEC SKU.",
  "type": "object",
  "additionalProperties": false,
  "required": ["passport_version", "passport_id", "passport_status", "commercial_truth", "authority", "execution", "evidence"],
  "properties": {
    "passport_version": { "type": "string", "const": "1.0.0" },
    "passport_id": { "type": "string", "pattern": "^EP-[A-Z0-9-]+$" },
    "passport_status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "SUSPENDED", "EXPIRED", "REVOKED"] },
    "commercial_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku", "name", "description", "owner", "seller", "price", "currency"],
      "properties": {
        "sku": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,99}$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/party" },
        "seller": { "$ref": "#/$defs/party" },
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "billing": { "type": "string", "enum": ["ONE_TIME", "RECURRING", "USAGE", "CUSTOM"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resale_allowed", "territories", "reseller_rights", "margin"],
      "properties": {
        "resale_allowed": { "type": "boolean" },
        "territories": { "type": "array", "items": { "type": "string", "minLength": 2 }, "minItems": 1, "uniqueItems": true },
        "reseller_rights": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "restrictions": { "type": "array", "items": { "type": "string" } },
        "margin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "amount", "currency"],
          "properties": {
            "type": { "type": "string", "enum": ["FIXED", "PERCENT", "NONE"] },
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fulfilment_method", "fulfilment_condition", "deployment_mode", "dependencies"],
      "properties": {
        "fulfilment_method": { "type": "string", "minLength": 1 },
        "fulfilment_condition": { "type": "string", "minLength": 1 },
        "deployment_mode": { "type": "string", "enum": ["ONLINE", "LOCAL", "OFFLINE", "AIR_GAPPED", "PHYSICAL", "HYBRID"] },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "support": { "type": "string" },
        "refund_rule": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "requirements", "verification_rule", "truth_status", "provenance", "conflict_disclosure"],
      "properties": {
        "required": { "type": "boolean" },
        "requirements": { "type": "array", "items": { "type": "string" } },
        "verification_rule": { "type": "string", "minLength": 1 },
        "truth_status": { "type": "string", "enum": ["UNVERIFIED", "VERIFIED", "CONTRADICTED", "STALE", "CONFLICTED"] },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } },
        "conflict_disclosure": { "type": "boolean" }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effective_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "version": { "type": "string" }
      }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "source", "observed_at", "method"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "method": { "type": "string", "minLength": 1 },
        "result": { "type": "string" }
      }
    }
  }
}
