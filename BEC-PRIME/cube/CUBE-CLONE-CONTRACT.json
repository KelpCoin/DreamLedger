  "neutral_host": "dreamledger",
  "isolation": {
    "catalog": true,
    "checkout": true,
    "analytics": true,
    "customer_data": true,
    "content": true,
    "promotion": true,
    "credentials": true
  },
  "forbidden_source_paths": [
    "BEC-PRIME/catalog/ip-capabilities.json",
    ".env",
    ".env.*",
    "secrets",
    "private",
    "proofs/private",
    "data/paid-transactions",
    "customer exports"
  ],
  "required_inputs": [
    "silo_name",
    "product_name",
    "price_nzd",
    "stripe_product_id"
  ],
  "silo_scaffold_required_inputs": [
    "slug",
    "display_name",
    "vertical",
    "route_candidate",
    "catalog_namespace",
    "isolation_policy_ref"
  ],
  "commercial_activation_required_inputs": [
    "sku_id",
    "explicit_price_and_currency",
    "verified_payment_endpoint",
    "settlement_handler_id",
    "fulfillment_contract_id",
    "delivery_proof_contract",
    "rollback_plan"
  ],
  "free_marketplace_policy": "A scaffold may offer free browsing and free listing without a Stripe SKU. It must not claim transaction handling or activate payment until the commercial activation gates pass.",
  "activation_rule": "Generation does not imply database provisioning, domain binding, production deployment, public activation, or promotion. Each requires separate evidence and authorization.",
  "economic_activation_rule": "A silo becomes economically active only when a verified supply atom and a buyer/payment atom exist; a live product additionally needs correct attribution, settlement, fulfillment, and retrievable delivery proof.",
  "money_claim_rule": "No revenue claim without verified payment evidence. Simulation benchmarks and predicted EPV are not evidence.",
  "domain_policy": "Candidate domain names are proposals only; do not call DNS or certificate APIs from the clone generator.",
  "credential_policy": "Never generate deterministic Stripe account IDs or wallet addresses and never store live credentials in a manifest."
}
