{
  "schema_version": "1.0",
  "purpose": "machine-readable contract for reducing repetitive human operation",
  "principles": [
    "observe_before_act",
    "authority_before_action",
    "verify_after_action",
    "record_consequential_actions",
    "unknown_means_quarantine",
    "idempotent_by_default",
    "human_only_for_unknown_high_risk_irreversible_or_authority_bound_actions"
  ],
  "required_sequence": [
    "TRIGGER",
    "INPUTS",
    "AUTHORITY",
    "DECISION",
    "ACTION",
    "VERIFICATION",
    "EVIDENCE",
    "FAILURE",
    "ESCALATION",
    "RESUME"
  ],
  "automation_families": [
    "exception-routing",
    "unknown-state-handling",
    "daily-operator-digest",
    "incident-memory",
    "failure-fingerprints",
    "rollback-control",
    "payment-recovery",
    "order-state-control",
    "customer-support-resolution",
    "catalog-repair",
    "inventory-reconciliation",
    "price-reconciliation",
    "offer-lifecycle",
    "revenue-reconciliation",
    "cash-anomaly-detection",
    "subscription-lifecycle",
    "entitlement-repair",
    "fulfillment-watchdog",
    "supplier-failure-routing",
    "sla-timers",
    "queue-health",
    "dead-letter-recovery",
    "stale-lease-recovery",
    "database-migration-control",
    "schema-drift-control",
    "backup-restore-verification",
    "secret-lifecycle-monitoring",
    "domain-health-monitoring",
    "webhook-reliability",
    "safe-event-replay",
    "evidence-pack-generation",
    "audit-trail-generation",
    "human-decision-compression",
    "approval-packet-generation",
    "kill-switch-control",
    "automation-health-metrics",
    "escalation-packet-generation",
    "change-impact-analysis",
    "automation-graduation",
    "operator-time-accounting"
  ],
  "minimum_contract_fields": [
    "runbook_id",
    "trigger",
    "inputs",
    "authority",
    "decision",
    "action",
    "verification",
    "evidence",
    "failure",
    "escalation",
    "resume",
    "idempotency",
    "kill_switch",
    "human_boundary"
  ]
}
