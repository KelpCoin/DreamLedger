<!doctype html>
<html lang="en-NZ">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MTG Marketplace | DreamLedger</title>
<style>
:root{--bg:#080a0d;--panel:#11161c;--line:#29323c;--ink:#f5f3eb;--muted:#9da8b4;--gold:#d8b56b;--good:#91d5a4;--bad:#ef9292}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 15% 0,#2b2418 0,#080a0d 36%);color:var(--ink);font-family:system-ui,-apple-system,sans-serif}.wrap{max-width:1100px;margin:auto;padding:18px 16px 70px}.nav{display:flex;justify-content:space-between;gap:12px;align-items:center;border-bottom:1px solid var(--line);padding-bottom:14px}.brand{font-weight:950;letter-spacing:.08em}.brand b{color:var(--gold)}nav{display:flex;gap:10px;flex-wrap:wrap}a{color:var(--muted);text-decoration:none}.hero{padding:34px 0 20px}.kicker{color:var(--gold);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;font-weight:900}.hero h1{font-size:clamp(2.5rem,8vw,5rem);line-height:.92;letter-spacing:-.06em;margin:9px 0 14px}.hero p{color:var(--muted);max-width:700px;line-height:1.55}.notice{border:1px solid var(--line);background:#10151b;border-radius:14px;padding:14px;color:var(--muted);margin:18px 0}.notice strong{color:var(--ink)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px}.card,.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px}.card h2{font-size:1.05rem;margin:0 0 5px}.meta{color:var(--muted);font-size:.78rem}.price{font-size:1.35rem;font-weight:900;margin:10px 0}.pill{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:4px 8px;color:var(--muted);font-size:.65rem;margin:3px 3px 0 0}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.btn{border:1px solid var(--line);background:#0b0f14;color:var(--ink);border-radius:9px;padding:10px 12px;font-weight:850;cursor:pointer}.primary{background:var(--gold);color:#111;border-color:var(--gold)}.btn:disabled{opacity:.45}.panel{margin-top:18px}.panel h2{margin-top:0}.form{display:grid;grid-template-columns:1fr 1fr;gap:10px}.field{display:flex;flex-direction:column;gap:5px}.field.full{grid-column:1/-1}.field label{font-size:.72rem;color:var(--muted)}input,select,textarea{width:100%;background:#0b0f14;color:var(--ink);border:1px solid var(--line);border-radius:9px;padding:10px;font:inherit}textarea{min-height:90px;resize:vertical}.checks{display:flex;gap:15px;flex-wrap:wrap;color:var(--muted);font-size:.82rem}.checks label{display:flex;gap:7px;align-items:center}.status{min-height:22px;color:var(--muted);margin-top:10px}.success{color:var(--good)}.error{color:var(--bad)}.hidden{display:none}.request{border-top:1px solid var(--line);padding:12px 0}.small{font-size:.74rem;color:var(--muted)}@media(max-width:650px){.form{grid-template-columns:1fr}.field.full{grid-column:auto}}
</style>
</head>
<body>
<div class="wrap">
<header class="nav"><div class="brand"><b>MAGIC</b> / MARKETPLACE</div><nav><a href="/mtg">MTG</a><a href="/account">Account</a><a href="/login">Login</a></nav></header>
<section class="hero"><div class="kicker">MTG silo / peer marketplace</div><h1>Buy it.<br>Trade it.</h1><p>List a real card, set a price, or say what you want in trade. Buyers can make a buy or trade request. The seller accepts or declines. This MVP takes <strong>NZ$0 platform fee</strong> on Magic listings.</p></section>
<div class="notice"><strong>Direct-contract MVP.</strong> DreamLedger records the listing and request, but does not collect auction or sale proceeds here. A seller acceptance is an agreement to proceed, not proof of settled payment.</div>

<section class="panel">
<h2>Marketplace</h2>
<div id="status" class="status">Loading listings...</div>
<div id="listings" class="grid"></div>
</section>

<section class="panel">
<h2>List a card</h2>
<p class="meta">You need an account. Trader status and contact details are captured for the seller record. No Magic platform fee is charged.</p>
<form id="listingForm" class="form">
<div class="field"><label>Card name *</label><input name="title" required maxlength="160" placeholder="e.g. Chrome Mox"></div>
<div class="field"><label>Set</label><input name="set_name" maxlength="120" placeholder="e.g. Special Guests"></div>
<div class="field"><label>Collector number</label><input name="collector_number" maxlength="40"></div>
<div class="field"><label>Condition</label><select name="condition"><option>Near Mint</option><option>Lightly Played</option><option>Moderately Played</option><option>Heavily Played</option><option>Damaged</option><option>Unspecified</option></select></div>
<div class="field"><label>Language</label><input name="language" value="English" maxlength="40"></div>
<div class="field"><label>Image URL</label><input name="image_url" type="url" maxlength="1000" placeholder="https://..."></div>
<div class="field"><label>Buy price NZD</label><input name="price_nzd" type="number" min="0.01" step="0.01" placeholder="50.00"></div>
<div class="field"><label>Trader status *</label><select name="trader_status" required><option value="">Choose...</option><option value="private">Private seller</option><option value="trader">Selling in trade</option></select></div>
<div class="field"><label>Contact address *</label><input name="contact_address" maxlength="300" placeholder="Required for physical listing"></div>
<div class="field"><label>Online trading identity</label><input name="online_trading_identity" maxlength="120" placeholder="Your marketplace name"></div>
<div class="field full"><label>Card description</label><textarea name="description" maxlength="1500" placeholder="Condition notes, language, notable defects, photos, etc."></textarea></div>
<div class="field full"><label>Trade wanted</label><textarea name="trade_wanted" maxlength="800" placeholder="What would you trade for?"></textarea></div>
<div class="field full checks"><label><input type="checkbox" name="accepts_buy" checked> Accept buy requests</label><label><input type="checkbox" name="accepts_trade"> Accept trade requests</label></div>
<div class="field full"><button class="btn primary" type="submit">List card</button></div>
</form>
<div id="listingStatus" class="status"></div>
</section>

<section class="panel">
<h2>My offers</h2>
<div id="requests" class="status">Log in to see your buy/trade requests.</div>
</section>
</div>
<script>
(function(){
const $=id=>document.getElementById(id);
const esc=v=>String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let listings=[];
async function api(url,opts){const r=await fetch(url,opts);const d=await r.json();if(!r.ok)throw new Error(d.error||'Request failed');return d;}
function render(d){
 listings=d.listings||[];
 $('status').textContent=listings.length?'':'No active cards yet. Be the first.';
 $('listings').innerHTML=listings.map(x=>'<article class="card"><span class="pill">'+esc(x.condition)+'</span><span class="pill">'+esc(x.trader_status==='trader'?'TRADER':'PRIVATE')+'</span><h2>'+esc(x.title)+'</h2><div class="meta">'+esc(x.set_name||'Set not supplied')+(x.collector_number?' · #'+esc(x.collector_number):'')+'</div><div class="price">'+(x.price_nzd!=null?'NZ$'+Number(x.price_nzd).toFixed(2):'Trade only')+'</div><div class="meta">'+esc(x.description||'No description.')+'</div><div class="meta">Seller: '+esc(x.seller_display_name||'Seller')+'</div><div class="actions">'+(x.accepts_buy?'<button class="btn primary" data-buy="'+esc(x.id)+'">Buy request</button>':'')+(x.accepts_trade?'<button class="btn" data-trade="'+esc(x.id)+'">Trade request</button>':'')+'</div></article>').join('');
 document.querySelectorAll('[data-buy]').forEach(b=>b.onclick=()=>offer(b.dataset.buy,'buy'));
 document.querySelectorAll('[data-trade]').forEach(b=>b.onclick=()=>offer(b.dataset.trade,'trade'));
 $('requests').innerHTML=(d.requests||[]).length?d.requests.map(r=>'<div class="request"><strong>'+esc(r.type.toUpperCase())+'</strong> · '+esc(r.status)+'<div class="small">Listing '+esc(r.listing_id)+(r.offered_amount_nzd?' · NZ$'+Number(r.offered_amount_nzd).toFixed(2):'')+(r.trade_offer?' · '+esc(r.trade_offer):'')+'</div>'+((r.seller_id===window.__accountId)&&r.status==='pending_seller_acceptance'?'<div class="actions"><button class="btn primary" data-accept="'+esc(r.id)+'">Accept</button><button class="btn" data-decline="'+esc(r.id)+'">Decline</button></div>':'')+'</div>').join(''):'No requests yet.';
 document.querySelectorAll('[data-accept]').forEach(b=>b.onclick=()=>decision(b.dataset.accept,'accept'));
 document.querySelectorAll('[data-decline]').forEach(b=>b.onclick=()=>decision(b.dataset.decline,'decline'));
}
async function load(){try{const d=await api('/api/mtg/marketplace/listings');const me=await api('/api/account/me');window.__accountId=me.account?.account_id||null;render(d);}catch(e){$('status').className='status error';$('status').textContent=e.message;}}
async function offer(id,type){
 let amount=null,trade=null;
 if(type==='buy'){const listing=listings.find(x=>x.id===id);const raw=prompt('Buy offer in NZD',listing&&listing.price_nzd!=null?String(listing.price_nzd):'');if(raw===null)return;amount=Number(raw);if(!Number.isFinite(amount)||amount<=0){alert('Enter a valid NZD amount.');return;}}
 else{trade=prompt('What are you offering in trade?');if(!trade)return;}
 try{await api('/api/mtg/marketplace/request',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({listing_id:id,type,offered_amount_nzd:amount,trade_offer:trade})});await load();alert(type==='buy'?'Buy request sent.':'Trade request sent.');}catch(e){alert(e.message);}
}
async function decision(id,decision){try{await api('/api/mtg/marketplace/request/decision',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({request_id:id,decision})});await load();}catch(e){alert(e.message);}}
$('listingForm').addEventListener('submit',async e=>{e.preventDefault();const fd=new FormData(e.currentTarget);const body=Object.fromEntries(fd.entries());body.accepts_buy=fd.get('accepts_buy')==='on';body.accepts_trade=fd.get('accepts_trade')==='on';try{await api('/api/mtg/marketplace/list',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});$('listingStatus').className='status success';$('listingStatus').textContent='Card listed. NZ$0 Magic marketplace fee.';e.currentTarget.reset();fd.get('accepts_buy');await load();}catch(err){$('listingStatus').className='status error';$('listingStatus').textContent=err.message;}});
load();
})();
</script>
</body>
</html>