{
  "schema": "dreamledger.silo-catalog/v1",
  "template": "mtg",
  "tiers": {
    "FREE": {
      "signal_lag": "coarse",
      "alerts": "limited"
    },
    "PAID": {
      "signal_lag": "priority",
      "alerts": "full"
    },
    "PREMIUM": {
      "signal_lag": "priority",
      "alerts": "full_plus_early"
    }
  },
  "silos": [
