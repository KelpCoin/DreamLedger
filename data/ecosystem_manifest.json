  "economic_loop": [
    "DEMAND",
    "OPPORTUNITY",
    "OFFER",
    "AUTHORITY_GATE",
    "EXTERNAL_ACTION",
    "PAYMENT",
    "FULFILMENT",
    "EVIDENCE",
    "VERIFIED_OUTCOME",
    "LEARNING"
